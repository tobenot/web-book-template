---
// 折叠式「答案」：练习本身用普通标题/正文写，只把答案包进这个组件里。
// 没有做单独的 <Exercise> 组件——练习就是一段普通 Markdown，没有需要额外行为的地方。
interface Props {
  title?: string;
}
const { title = '查看答案' } = Astro.props;
---

<details class="book-solution not-content">
  <summary>{title}</summary>
  <div class="book-solution__body">
    <slot />
  </div>
</details>

<style>
  .book-solution {
    margin-block: 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--book-border);
    border-radius: 6px;
    background: var(--book-surface-1);
  }

  .book-solution summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--book-accent);
  }

  .book-solution[open] summary {
    margin-bottom: 0.6rem;
  }

  .book-solution__body > :first-child {
    margin-top: 0;
  }

  .book-solution__body > :last-child {
    margin-bottom: 0;
  }
</style>
