---
// 覆盖 Starlight 默认 Head：
//  · 保留 Starlight 自动注入的 title / description / canonical / og:title / og:description / og:url
//  · 在此基础上追加 JSON-LD 结构化数据，给 Google 富搜索结果用
//
// 注入策略：
//  · 首页 (index)：WebSite + Book schema
//  · 章节页：TechArticle + BreadcrumbList
//  · 减法页（about / preface）：Article + BreadcrumbList
//  · /dev/ 内部页：不注入（会被 sitemap 过滤掉，noindex）
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const data = (entry?.data ?? {}) as Record<string, any>;

const id: string = entry?.id ?? '';
const isHome = id === '' || id === 'index';
const isDev = id.startsWith('dev/');

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://your-book.pages.dev/').toString();

// per-page OG 卡片：与 scripts/build-og.mjs 的命名规则保持一致
//   首页（id 为空 / 'index'）→ /og/index.png
//   其他页（id = 'getting-started/curiosity' 等）→ /og/getting-started__curiosity.png
// PNG 由 prebuild 钩子统一生成，落在 /public/og/ 下，不入 git。
function ogImageFor(entryId: string): string {
  const trimmed = (entryId || '').replace(/^\/+|\/+$/g, '');
  const fileName = !trimmed || trimmed === 'index' ? 'index.png' : trimmed.replace(/\//g, '__') + '.png';
  return `${siteUrl}/og/${fileName}`;
}
const ogImage = ogImageFor(id);

// 换成书名和作者信息（和 astro.config.mjs 里的 bookTitle 保持一致）
const bookTitle = '你的书名';
const author = {
  '@type': 'Person',
  name: '你的名字',
  url: 'https://your-site.example',
};

// 面包屑：按 URL 路径段拼出来
function buildBreadcrumb(): any | null {
  if (isHome) return null;
  const segments = id.split('/').filter(Boolean);
  if (!segments.length) return null;

  // 目录名 → 显示名。新增一「部」时在这里加一行，和 astro.config.mjs 的
  // sidebar/SiteTitle.astro 的 partMap 保持一致；没配置的目录直接显示原始目录名。
  const partLabels: Record<string, string> = {};

  const items: any[] = [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: `${siteUrl}/`,
    },
  ];

  let acc = '';
  segments.forEach((seg, idx) => {
    acc += `/${seg}`;
    const isLast = idx === segments.length - 1;
    let name: string;
    if (isLast) {
      name = (data.title as string) ?? seg;
    } else {
      name = partLabels[seg] ?? seg;
    }
    items.push({
      '@type': 'ListItem',
      position: idx + 2,
      name,
      item: `${siteUrl}${acc}/`,
    });
  });

  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items,
  };
}

// 章节页 / 减法页：Article 系列
function buildArticle(): any | null {
  if (isHome) return null;
  const isTech = !!data.chapterType && data.chapterType !== 'part-intro';
  const lastUpdated =
    data.lastUpdated instanceof Date
      ? data.lastUpdated.toISOString()
      : typeof data.lastUpdated === 'string'
      ? data.lastUpdated
      : undefined;
  return {
    '@context': 'https://schema.org',
    '@type': isTech ? 'TechArticle' : 'Article',
    headline: data.title,
    description: data.description ?? data.summary,
    inLanguage: 'zh-CN',
    isPartOf: {
      '@type': 'Book',
      name: bookTitle,
      url: `${siteUrl}/`,
    },
    author,
    publisher: author,
    image: ogImage,
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    ...(lastUpdated ? { dateModified: lastUpdated } : {}),
  };
}

// 首页：WebSite + Book
function buildHomeLd(): any[] {
  if (!isHome) return [];
  return [
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: bookTitle,
      url: `${siteUrl}/`,
      inLanguage: 'zh-CN',
      description: data.description,
      author,
      publisher: author,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Book',
      name: bookTitle,
      url: `${siteUrl}/`,
      inLanguage: 'zh-CN',
      bookFormat: 'https://schema.org/EBook',
      author,
      publisher: author,
      image: ogImage,
      // 换成你书的主题关键词，用于结构化数据（Google 富搜索结果）
      about: ['关键词一', '关键词二', '关键词三'],
    },
  ];
}

const lds: any[] = [];
if (!isDev) {
  if (isHome) {
    lds.push(...buildHomeLd());
  } else {
    const article = buildArticle();
    if (article) lds.push(article);
    const crumbs = buildBreadcrumb();
    if (crumbs) lds.push(crumbs);
  }
}
---

<Default {...Astro.props}><slot /></Default>

{/* /dev/ 路径整体 noindex，防止开发样例页被索引 */}
{isDev && <meta name="robots" content="noindex, nofollow" />}

{/* per-page 社交分享卡：覆盖 astro.config.mjs 里删掉的全局 og:image */}
{!isDev && (
  <>
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={data.title ?? bookTitle} />
    <meta name="twitter:image" content={ogImage} />
  </>
)}

{lds.map((ld) => (
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
))}
